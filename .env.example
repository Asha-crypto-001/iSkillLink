# ==========================================
# iSkillLink Uganda - Environment Config
# ==========================================

# Server Port
PORT=3001
NODE_ENV=production

# Platform Administrator Credentials (HQ: Mbarara City)
# ADMIN_PASSWORD is only used when the API seeds a fresh database (min. 8 characters).
# Changing it later does not change an existing admin's password.
ADMIN_EMAIL=ashabahebwahassan665@gmail.com
ADMIN_PASSWORD=your_secure_admin_password_here

# API database: application state is stored in PostgreSQL when set (required in production).
# On Vercel use Supabase's Transaction pooler string (port 6543), not the direct :5432 address.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres

# Comma-separated frontend origins allowed to call the API. Same-origin requests (site and API
# on one host, as on Vercel) are always allowed, so this is only needed for a separate frontend.
CLIENT_ORIGIN=http://localhost:3000

# Vercel Blob token for avatar uploads; added automatically when a Blob store is connected.
# Without it, uploads go to local disk, or answer 503 on Vercel (read-only filesystem).
BLOB_READ_WRITE_TOKEN=

# Frontend: base URL of the Express API, ending in /api (e.g. https://iskilllink-api.onrender.com/api).
# Leave unset for local development (Vite proxies /api). When unset in a static build, the
# site runs in browser-only demo mode whenever no API answers.
VITE_API_URL=

# Supabase Auth (frontend). When set, sign-in uses Supabase and the API accepts Supabase sessions.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_AUTH_URL=https://your-project.supabase.co/functions/v1/auth

# Supabase Auth (API): used to verify Supabase access tokens. Defaults to the VITE_ values above.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Google Identity Services web client ID (same audience configured on the API).
# The site currently has no Google sign-in button; without it /api/auth/google answers 503.
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Generate a long random value for production; rotate it after security incidents.
JWT_SECRET=replace-with-a-long-random-production-secret
