# ==========================================
# iSkillLink Uganda - Environment Config
# ==========================================

# Server Port
PORT=3001
NODE_ENV=production

# Platform Administrator Credentials (HQ: Mbarara City)
ADMIN_EMAIL=ashabahebwahassan665@gmail.com
ADMIN_PASSWORD=your_secure_admin_password_here

# Frontend API URL (for production hosting such as Vercel or Render)
VITE_API_URL=https://your-api-domain.com/api
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres

# Google Identity Services web client ID (same audience configured on the API)
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Generate a long random value for production; rotate it after security incidents.
JWT_SECRET=replace-with-a-long-random-production-secret
